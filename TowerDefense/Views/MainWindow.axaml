<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TowerDefense.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TowerDefense.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TowerDefense">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Viewbox Stretch="Uniform" Margin="20">

        <!-- Le Grid qui empile les deux calques -->
        <Grid>

            <!-- CALQUE 1 : les cases -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding MapWidth}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TileViewModel">
                        <Rectangle Width="40" Height="40" Fill="{Binding Color}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CALQUE 2 : les ennemis, par-dessus -->
            <ItemsControl ItemsSource="{Binding Enemies}">

                <!-- Un Canvas de la même taille que la carte -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="{Binding MapPixelWidth}"
                                Height="{Binding MapPixelHeight}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- La position de chaque ennemi -->
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="vm:EnemyViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>

                <!-- Le dessin d'un ennemi : un rond -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnemyViewModel">
                        <Ellipse Width="{Binding Diameter}"
                                 Height="{Binding Diameter}"
                                 Fill="{Binding Color}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Viewbox>

</Window>